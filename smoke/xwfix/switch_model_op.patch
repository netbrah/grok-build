+XWFIX_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(
+    os.path.abspath(__file__))))
+
+
+def _xwfix_cell_dir(cell):
+    return (cell if os.path.isabs(cell)
+            else os.path.join(XWFIX_REPO_ROOT, cell))
+
