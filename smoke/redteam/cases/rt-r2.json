{
  "id": "RT-R2",
  "title": "Resume+switch: RT-R1 state, resume with -m gpt-5.6-sol, 2 turns (= RT-M1 via the resume path)",
  "model": "qwen3.8-27b",
  "steps": [
    {
      "op": "turn",
      "prompt": "RT-R2 Q1: Reply with exactly: RT-R2-Q1"
    },
    {
      "op": "turn",
      "prompt": "RT-R2 Q2: Reply with exactly: RT-R2-Q2"
    },
    {
      "op": "kill",
      "after_s": 2.5,
      "prompt": "RT-R2 KILLED"
    },
    {
      "op": "switch",
      "model": "gpt-5.6-sol",
      "via": "resume"
    },
    {
      "op": "turn",
      "prompt": "RT-R2 S1: Reply with exactly: RT-R2-S1"
    },
    {
      "op": "turn",
      "prompt": "RT-R2 S2: Reply with exactly: RT-R2-S2"
    }
  ],
  "watchdog_s": 300,
  "est_calls": 7,
  "assert": {
    "exit": 0,
    "ndjson": [
      {
        "op": "absent",
        "event": "error"
      },
      {
        "op": "text_contains",
        "value": "RT-R2-S2"
      }
    ],
    "wire": [
      {
        "kind": "field",
        "file": "req-*.json",
        "path": "$.body.model",
        "eq": "gpt-5.6-sol",
        "where": {
          "method": "POST",
          "path": "/v1/responses"
        }
      },
      {
        "kind": "grep",
        "file": "req-*.json",
        "grep": "RT-R2-Q1",
        "where": {
          "method": "POST",
          "path": "/v1/responses"
        }
      }
    ]
  }
}
