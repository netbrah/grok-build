{
  "id": "RT-C6",
  "title": "256k pinned window on 1M-capable model (claude-sonnet-5, messages wire): auto-compact at ~218k DESPITE 1M capability (config_patch pins the model-row context_window=256000: the case's own math — 222k seed vs the 85% threshold = ~217.6k -> window 256000, as in the 2026-09-14 green baseline at 86% usage. The catalog row drifted 256k->1M operator-intentionally and beats the [endpoints] default by documented resolver design, so the premise now rides the config tier — SWEEPFIX-VERIFY, F-COMP adjudication)",
  "model": "claude-sonnet-5",
  "config_patch": {
    "model/claude-sonnet-5/context_window": 256000
  },
  "seed": {
    "hist_tokens": 222000,
    "hist_bytes": 1073400
  },
  "steps": [
    {
      "op": "turn",
      "prompt": "Reply with exactly: RT-C6-OK"
    }
  ],
  "watchdog_s": 600,
  "est_calls": 3,
  "assert": {
    "exit": 0,
    "ndjson": [
      {
        "op": "absent",
        "event": "error"
      }
    ],
    "artifact": [
      {
        "file": "compaction/segment_*.md",
        "op": "count",
        "min": 1
      },
      {
        "file": "compaction_checkpoints/*.json",
        "op": "count",
        "min": 1
      },
      {
        "file": "compaction_requests/*.json",
        "field": "$.error",
        "eq": null,
        "absent_ok": true,
        "which": "last"
      },
      {
        "file": "compaction_requests/*.json",
        "field": "$.summary",
        "ne_null": true,
        "absent_ok": true,
        "which": "last"
      }
    ],
    "wire": [
      {
        "kind": "field",
        "file": "req-*.json",
        "path": "$.body.model",
        "eq": "claude-sonnet-5",
        "where": {
          "method": "POST",
          "path": "/v1/messages"
        },
        "nth": 0
      }
    ]
  }
}
