{
  "id": "RT-C6",
  "title": "256k policy window on 1M-capable model (claude-sonnet-5, messages wire): auto-compact at ~218k DESPITE 1M capability",
  "expected_red": {
    "id": "CONTEXT-1",
    "reason": "documented red (pass-4 adjudicated): auto-compact did NOT fire for claude-sonnet-5 under the [endpoints] default_context_window=256000 policy (no per-row window in the hermetic config) - ~222k-token seed completed a clean turn with zero compaction artifacts; CONTEXT-1 audit pending"
  },
  "model": "claude-sonnet-5",
  "seed": {
    "hist_tokens": 222000,
    "hist_bytes": 1073400
  },
  "steps": [
    {
      "op": "turn",
      "prompt": "Reply with exactly: RT-C6-OK"
    }
  ],
  "watchdog_s": 600,
  "est_calls": 3,
  "assert": {
    "exit": 0,
    "ndjson": [
      {
        "op": "absent",
        "event": "error"
      }
    ],
    "artifact": [
      {
        "file": "compaction/segment_*.md",
        "op": "count",
        "min": 1
      },
      {
        "file": "compaction_checkpoints/*.json",
        "op": "count",
        "min": 1
      },
      {
        "file": "compaction_requests/*.json",
        "field": "$.error",
        "eq": null,
        "absent_ok": true,
        "which": "last"
      },
      {
        "file": "compaction_requests/*.json",
        "field": "$.summary",
        "ne_null": true,
        "absent_ok": true,
        "which": "last"
      }
    ],
    "wire": [
      {
        "kind": "field",
        "file": "req-*.json",
        "path": "$.body.model",
        "eq": "claude-sonnet-5",
