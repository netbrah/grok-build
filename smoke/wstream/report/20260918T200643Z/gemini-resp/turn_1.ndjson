{"type":"text","data":"192^2 = 4804864 \\equiv 3616 \\pmod{"}
{"type":"text","data":"5557}$\n*   $7^{32} \\equiv 3616^2 ="}
{"type":"text","data":" 13075456 \\equiv 5392 \\pmod{5557}$"}
{"type":"text","data":"\n*   $7^{64} \\equiv 5392^2 = 2907"}
{"type":"text","data":"3664 \\equiv 4997 \\pmod{5557}$\n*   $7"}
{"type":"text","data":"^{128} \\equiv 4997^2 = 24970009"}
{"type":"text","data":" \\equiv 2408 \\pmod{5557}$\n*   $7^{256"}
{"type":"text","data":"} \\equiv 2408^2 = 5798464 \\equiv 25"}
{"type":"text","data":"13 \\pmod{5557}$\n*   $7^{512} \\equiv 2"}
{"type":"text","data":"513^2 = 6315169 \\equiv 2417 \\pmod{"}
{"type":"text","data":"5557}$\n*   $7^{1024} \\equiv 2417^"}
{"type":"text","data":"2 = 5841889 \\equiv 1482 \\pmod{5557"}
{"type":"text","data":"}$\n*   $7^{2048} \\equiv 1482^2 = 2"}
{"type":"text","data":"196324 \\equiv 1309 \\pmod{5557}$\n*   "}
{"type":"text","data":"$7^{4096} \\equiv 1309^2 = 17134"}
